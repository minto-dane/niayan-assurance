-- SPDX-License-Identifier: MIT
project Assurance is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "runtime", "app");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build/bin";
   for Main use ("assure.adb", "controlctl.adb", "platformctl.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-gnatVa", "-gnatwe", "-fstack-protector-strong", "-fPIE", "-g", "-O1");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use
        ("-lsodium", "-larchive", "-lcurl", "-lxml2", "-pie", "-Wl,-z,relro,-z,now,-z,noexecstack");
   end Linker;
end Assurance;
