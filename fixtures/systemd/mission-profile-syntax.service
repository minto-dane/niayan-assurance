# SPDX-License-Identifier: MIT
# Independent syntax fixture; not output executed by the Ada renderer.
[Unit]
Description=Offline bounded service profile syntax fixture
StartLimitIntervalSec=300
StartLimitBurst=3
[Service]
Type=exec
User=missionfixture
Group=missionfixture
ExecStart=/usr/bin/true
UMask=0077
StateDirectory=missionfixture
StateDirectoryMode=0700
MemoryMax=67108864
TasksMax=16
CPUQuota=50%
Restart=no
TimeoutStartSec=60s
TimeoutStopSec=60s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
StandardOutput=journal
StandardError=journal
