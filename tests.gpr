-- SPDX-License-Identifier: MIT
project Tests is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "runtime", "tests");
   for Object_Dir use "build/test-obj";
   for Exec_Dir use "build/test-bin";
   for Main use ("run_cohort_recovery_tests.adb", "run_journal_budget_tests.adb", "run_fs_observation_tests.adb", "run_command_lifecycle_tests.adb", "run_receiver_ledger_tests.adb", "run_request_replay_tests.adb", "run_recovery_storage_tests.adb", "run_qualification_tests.adb", "run_contract_tests.adb", "run_ingress_tests.adb", "run_v2_tests.adb", "run_resilience_contract_tests.adb", "run_control_tests.adb", "run_backup_contract_tests.adb", "run_control_io_tests.adb", "run_checkpoint_io_tests.adb", "run_control_vector_tests.adb", "run_stop_barrier_tests.adb", "run_stop_vector_tests.adb", "run_platform_assurance_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-gnatVa", "-gnatwe", "-fstack-protector-strong", "-fPIE", "-ffile-prefix-map=" & Tests'Project_Dir & "=/usr/src/niaos/assurance/", "-g", "-gno-record-gcc-switches", "-O1");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use
        ("-lsodium", "-larchive", "-lcurl", "-lxml2", "-pie", "-Wl,-z,relro,-z,now,-z,noexecstack");
   end Linker;
end Tests;
